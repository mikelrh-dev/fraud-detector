# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit the resulting .env (it is gitignored).
# ---------------------------------------------------------------------------

# Environment: development | production
# This is the canonical name. API_ENV is still accepted as an alias, but
# ENVIRONMENT is what the code reads — setting only API_ENV used to leave the
# whole production branch (secret guard, CORS lockdown, docs disabled) inert.
ENVIRONMENT=development

# Database
DB_USER=fraud
DB_PASSWORD=change_me_in_production
DB_NAME=fraud_detector
DB_HOST=localhost
DB_PORT=5432

# Redis
# REDIS_PASSWORD has no default in Settings: the app refuses to boot without it.
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_generate_a_random_secret_key

# JWT — required in production; the dev default is ephemeral and per-process.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Proxy
# Trust X-Real-IP / X-Forwarded-For for client identity.
# Enable ONLY behind a trusted reverse proxy that OVERWRITES those headers.
# Leave false when the API port is reachable directly: otherwise a client can
# spoof its IP and bypass the rate limiter entirely.
TRUST_PROXY_HEADERS=false

# Frontend
# In production this becomes the only allowed CORS origin.
FRONTEND_URL=http://localhost:3000
