# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit the resulting .env (it is gitignored).
# ---------------------------------------------------------------------------

# Environment: development | production
# This is the canonical name. API_ENV is still accepted as an alias, but
# ENVIRONMENT is what the code reads — setting only API_ENV used to leave the
# whole production branch (secret guard, CORS lockdown, docs disabled) inert.
ENVIRONMENT=development

# Database
DB_USER=fraud
DB_PASSWORD=change_me_in_production
DB_NAME=fraud_detector
DB_HOST=localhost
DB_PORT=5432

# Redis
# REDIS_PASSWORD has no default in Settings: the app refuses to boot without it.
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# Ollama
OLLAMA_HOST=http://localhost:11434
# Must match a model actually pulled in the Ollama container. Nothing pulls it
# for you — run: docker compose exec ollama ollama pull llama3.2:1b
# Otherwise every report 404s and lands in fraud:dlq after 3 retries.
OLLAMA_MODEL=llama3.2:1b

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_generate_a_random_secret_key

# JWT — required in production; the dev default is ephemeral and per-process.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Proxy
# Trust X-Real-IP / X-Forwarded-For for client identity.
# Only safe behind a reverse proxy that OVERWRITES those headers, never
# APPENDS them. docker/nginx.conf overwrites with $remote_addr, so the compose
# stack sets this to true in its own environment.
#
# The API port is no longer published to the host (A3), so nginx is the only
# ingress and the per-IP rate limiter sees real client addresses. If you run the
# API outside compose and expose the port directly, set this to false: otherwise
# a client spoofs its IP per request and bypasses the rate limiter entirely.
TRUST_PROXY_HEADERS=false

# Frontend
# In production this becomes the only allowed CORS origin.
FRONTEND_URL=http://localhost:3000
